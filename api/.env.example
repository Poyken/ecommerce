NODE_ENV=development
PORT=8080

# ============================================================
# DATABASE CONFIGURATION
# ============================================================
# Main connection URL (use PgBouncer in production)
DATABASE_URL="postgresql://postgres:123456@localhost:5432/ecommerce?schema=public"

# Direct URL for Prisma migrations (bypass PgBouncer)
DIRECT_URL="postgresql://postgres:123456@localhost:5432/ecommerce?schema=public"

# Connection Pool Settings (Prisma Driver Adapter)
USE_PG_ADAPTER=false
DB_POOL_SIZE=20
DB_POOL_MIN=5
DB_IDLE_TIMEOUT=30000
DB_CONNECT_TIMEOUT=10000
DB_SSL=false

# ============================================================
# REDIS CONFIGURATION  
# ============================================================
# Single Instance
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD=
REDIS_TLS=false

# Cluster Mode (for production scale)
REDIS_CLUSTER=false
REDIS_CLUSTER_NODES=node1:6379,node2:6379,node3:6379

# ============================================================
# JWT SECRETS (CHANGE THESE IN PRODUCTION!)
# ============================================================
JWT_ACCESS_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-this-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ============================================================
